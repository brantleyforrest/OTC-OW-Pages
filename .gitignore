# Ignore all Markdown files except README.md
*.md
!README.md
!readme.md

# Microsoft Word documents and lock files
*.doc
*.docx
*.docm
*.dotx
*.dotm
~$*.doc*

# PDF files
*.pdf

# PowerPoint presentations and lock files
*.ppt
*.pptx
*.pptm
*.potx
*.potm
*.pps
*.ppsx
~$*.ppt*


# Server: private files, local data, generated deploy files, and packages (never commit)
_server/secrets/
_server/data/
_server/deploy/out/
node_modules/

# Local copies of CDN libraries from scripts/fetch_vendor.py (pages fall back to the CDN without them)
/vendor/
/vendor-*/
