# Local Claude Code settings (never commit)
.claude/

# Ignore all Markdown files except README.md
*.md
!README.md
!readme.md
!math/SETTINGS-EFFECTS.md

# Microsoft Word documents and lock files
*.doc
*.docx
*.docm
*.dotx
*.dotm
~$*.doc*

# PDF files
*.pdf

# PowerPoint presentations and lock files
*.ppt
*.pptx
*.pptm
*.potx
*.potm
*.pps
*.ppsx
~$*.ppt*


# Server: private files, local data, generated deploy files, and packages (never commit)
_server/secrets/
_server/data/
_server/deploy/out/
node_modules/

# Three.js is the one library not committed: scripts/fetch_vendor.py downloads it into
# vendor/three/, and pages fall back to the CDN without it. vendor/fonts and vendor/katex are committed.
/vendor/three/
/vendor/*-*/
/vendor-*/
